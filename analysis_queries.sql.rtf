\f0\fs24 \cf0 -- UPI & Digital Payments Analysis\
-- Source: NPCI Official Data (2022-2025)\
-- Author: Your Name\
\
USE upi_india;\
\
-- Q1: Yearly UPI Growth\
SELECT RIGHT(month, 4) AS year,\
  ROUND(SUM(upi_volume_mn), 2) AS total_volume_mn,\
  ROUND(SUM(upi_value_cr), 2) AS total_value_cr\
FROM upi_master\
GROUP BY year ORDER BY year;\
\
-- Q2: Top 5 months by transactions\
SELECT month, upi_volume_mn, upi_value_cr\
FROM upi_master\
ORDER BY upi_volume_mn DESC LIMIT 5;\
\
-- Q3: UPI market share vs other modes\
SELECT month_year, upi_vol_lakh, neft_vol_lakh,\
  imps_vol_lakh, cards_vol_lakh,\
  ROUND(upi_vol_lakh / (upi_vol_lakh + neft_vol_lakh + \
  imps_vol_lakh + cards_vol_lakh) * 100, 2) AS upi_market_share_pct\
FROM payment_comparison ORDER BY date_val;\
\
-- Q4: Festive season analysis\
SELECT SUBSTRING_INDEX(month, '-', 1) AS month_name,\
  ROUND(AVG(upi_volume_mn), 2) AS avg_volume\
FROM upi_master\
GROUP BY month_name ORDER BY avg_volume DESC;\
\
-- Q5: Avg ticket size trend\
SELECT month, upi_volume_mn, upi_value_cr, avg_ticket_size\
FROM upi_master ORDER BY date_val;}